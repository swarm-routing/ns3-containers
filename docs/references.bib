% org-sync:begin bib-header
% docs/references.bib: the works this repository relies on, one entry each
% (swarm-routing/.github CONTRIBUTING "References"; checked in CI by
% `fidelity.py bib check` once the file has an entry).
%
% Roles, in `keywords`: implemented (the work this repository implements),
% restates, compared, dataset, tool, background. Where org-sync manages the
% citation (`citation = true` in .github/org-sync.toml), the implemented, tool
% and dataset entries are rendered into the README's "Releases & citing"
% section on the next `org_sync.py apply`, and `org_sync.py citation-refs .`
% rewrites CITATION.cff's `references:` from them (that block alone; review
% the diff): edit them here, never there.
%
% Every entry gives its DOI; a url only for a work that has none. Never this
% repository's own DOI: CITATION.cff carries it. Public sources only: a work is
% cited by its DOI link, never by where a copy of it is kept.
%
% Never type an entry or a field: take it from Crossref, DataCite or Zenodo,
% or, for a work with no DOI (a thesis, a report), from its publisher's or
% institution's record, URL being that record's landing page (its url, no doi):
%   python3 -I tools/fidelity/fidelity.py bib entry DOI --key K --role R
%   python3 -I tools/fidelity/fidelity.py bib entry --url URL --key K --role R
%   python3 -I tools/zenodo/zenodo.py bibtex OWNER/REPO --key K --role tool
% (all in swarm-routing/.github). Only two fields are the repository's own,
% added by hand after pasting: `note`, one line on why the work is cited, and
% `notdoi`, a DOI `bib check --online` matched to another work of the same
% title. With nothing to cite yet, the file stays
% this header alone.
% org-sync:end bib-header

@incollection{RH10,
  author    = {Riley, George F. and Henderson, Thomas R.},
  title     = {The ns-3 Network Simulator},
  booktitle = {Modeling and Tools for Network Simulation},
  pages     = {15--34},
  publisher = {Springer Berlin Heidelberg},
  year      = {2010},
  doi       = {10.1007/978-3-642-12331-3_2},
  note      = {The simulator every image builds, configured and pre-built at /opt/ns-3.},
  keywords  = {tool}
}
